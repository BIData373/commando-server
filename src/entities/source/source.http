# @import ../../../global.http

### Create Source — valid payload
POST {{baseUrl}}/source
...headers
Content-Type: multipart/form-data

name=HTTP Test Source
workspaceId={{workspaceId}}

{{@response
  exports.sourceId = response.parsedBody.id;
}}

?? status == 201

### Create Source — missing name (expect 400)
POST {{baseUrl}}/source
...headers
Content-Type: multipart/form-data

workspaceId={{workspaceId}}

?? status == 400

### Get Sources in workspace
GET {{baseUrl}}/source?workspaceId={{workspaceId}}
...headers

?? status == 200

### Get Source by id
GET {{baseUrl}}/source/{{sourceId}}
...headers

?? status == 200

### Update Source name
PATCH {{baseUrl}}/source/{{sourceId}}
...headers

{
  "name": "HTTP Test Source Updated",
  "tags": ["updated"]
}

?? status == 200

### Delete Source — non-existent id (expect 400)
DELETE {{baseUrl}}/source/99999
...headers

?? status == 400

### Cleanup — Delete Source
DELETE {{baseUrl}}/source/{{sourceId}}
...headers

?? status == 200
