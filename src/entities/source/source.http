# @import ../../../global.http

### Create Source — valid payload
POST {{baseUrl}}/source
...headers
Content-Type: multipart/form-data

name=Radio
workspaceId={{workspaceId}}
date=2024-01-01T00:00:00.000Z
tags[0]=tag1
attachment< ./sample.pdf

{{@response
  exports.sourceId = response.parsedBody.id;
}}

?? status == 201

### Create Source — with embedded tasks
POST {{baseUrl}}/source
...headers
Content-Type: multipart/form-data

name=Radio With Tasks
workspaceId={{workspaceId}}
tasks[0][title]=Review notes
tasks[0][deadlineType]=DATE
tasks[0][tags][0]=urgent
tasks[1][title]=Follow up
tasks[1][deadlineType]=ROLLING

?? status == 201

### Create Source — with AI extraction
POST {{baseUrl}}/source
...headers
Content-Type: multipart/form-data

name=AI Extracted Source
workspaceId={{workspaceId}}
aiExtraction=true
attachment< ./sample.pdf

?? status == 201

### Create Source — missing required field (expect 400)
POST {{baseUrl}}/source
...headers
Content-Type: multipart/form-data

workspaceId={{workspaceId}}

?? status == 400

### Create Source — insufficient permission (expect 403)
POST {{baseUrl}}/source
...headers
is-bi: false
Content-Type: multipart/form-data

name=Radio
workspaceId={{workspaceId}}

?? status == 403

### Get all Sources in workspace
GET {{baseUrl}}/source?workspaceId={{workspaceId}}
...headers

?? status == 200

{{@response
  exports.sourceId = response.parsedBody[0].id;
}}

### Get Source by id
GET {{baseUrl}}/source/{{sourceId}}
...headers

?? status == 200

### Get Source by id — insufficient permission (expect 403)
GET {{baseUrl}}/source/{{sourceId}}
...headers
is-bi: false

?? status == 403

### Update Source — with new attachment
PATCH {{baseUrl}}/source/{{sourceId}}
...headers
Content-Type: multipart/form-data

name=Radio Updated
attachment< ./sample-updated.pdf

?? status == 200

### Update Source — name only
PATCH {{baseUrl}}/source/{{sourceId}}
...headers

{
  "name": "Radio Updated",
  "date": "2026-06-02T15:10:59.225Z",
  "tags": ["a", "b"]
}

?? status == 200

### Update Source — insufficient permission (expect 403)
PATCH {{baseUrl}}/source/{{sourceId}}
...headers
is-bi: false
Content-Type: multipart/form-data

name=Radio Updated

?? status == 403

### Extract source — insufficient permission (expect 403)
POST {{baseUrl}}/source/{{sourceId}}/extract
...headers
is-bi: false

?? status == 403

### Delete Source — insufficient permission (expect 403)
DELETE {{baseUrl}}/source/{{sourceId}}
...headers
is-bi: false

?? status == 403

### Delete Source — non-existent id (expect 400)
DELETE {{baseUrl}}/source/99999
...headers

?? status == 400

### Delete Source
DELETE {{baseUrl}}/source/{{sourceId}}
...headers

?? status == 200

### Extract source — valid
POST {{baseUrl}}/source/{{sourceId}}/extract
...headers

?? status == 201

### Extract source — non-existent id (expect 400)
POST {{baseUrl}}/source/99999/extract
...headers

?? status == 400

### AI Result — success with tasks
POST {{baseUrl}}/source/{{sourceId}}/ai-result
...headers

{
  "tasks": [
    {
      "title": "Review extracted document",
      "deadlineType": "DATE",
      "deadlineDate": "2026-08-01T00:00:00.000Z",
      "assigneeIds": []
    },
    {
      "title": "Follow up with team",
      "deadlineType": null,
      "deadlineDate": null,
      "assigneeIds": []
    }
  ]
}

?? status == 201

### AI Result — success without tasks
POST {{baseUrl}}/source/{{sourceId}}/ai-result
...headers

{}

?? status == 201

### AI Result — failure (BACKEND_ERROR)
POST {{baseUrl}}/source/{{sourceId}}/ai-result
...headers

{
  "error": "BACKEND_ERROR"
}

?? status == 201

### AI Result — failure (AI_SERVICE_ERROR)
POST {{baseUrl}}/source/{{sourceId}}/ai-result
...headers

{
  "error": "AI_SERVICE_ERROR"
}

?? status == 201