### Create Source — valid payload
POST {{baseUrl}}/source
...formHeaders
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="name"

Radio
--{{boundary}}
Content-Disposition: form-data; name="workspaceId"

{{workspaceId}}
--{{boundary}}
Content-Disposition: form-data; name="date"

2024-01-01T00:00:00.000Z
--{{boundary}}
Content-Disposition: form-data; name="tags[0]"

tag1
--{{boundary}}
Content-Disposition: form-data; name="attachment"; filename="sample.pdf"
Content-Type: application/pdf

< ./sample.pdf
--{{boundary}}--

{{@response
  exports.sourceId = response.parsedBody.id;
}}

?? status == 201

