model Source {
  id               Int               @id @default(autoincrement())
  name             String
  date             DateTime?
  attachmentKey    String?           @map("attachment_key")
  attachmentName   String?           @map("attachment_name")
  draft            Boolean           @default(false)
  extractionStatus ExtractionStatus? @map("extraction_status")

  workspaceId Int       @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById Int  @map("created_by")
  createdBy   User @relation("source_created_by", fields: [createdById], references: [id])

  updatedById Int  @map("updated_by")
  updatedBy   User @relation("source_updated_by", fields: [updatedById], references: [id])

  deletedById Int? @map("deleted_by")
  deletedBy   User? @relation("source_deleted_by", fields: [deletedById], references: [id])

  tasks Task[]

  tags Tag[] @relation("sources_tags")

  @@map("sources")
}

enum ExtractionStatus {
  PENDING
  IN_PROGRESS
  BACKEND_ERROR
  AI_SERVICE_ERROR
  FINISHED_WITH_TASKS
  FINISHED_WITHOUT_TASKS
}
