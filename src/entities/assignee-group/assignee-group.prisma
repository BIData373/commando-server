model AssigneeGroup {
  id   Int    @id @default(autoincrement())
  name String

  workspaceId Int       @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  assignees Assignee[] @relation("assignee_groups_assignees")

  // Meta Fields
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById Int  @map("created_by")
  createdBy   User @relation("assignee_group_created_by", fields: [createdById], references: [id])

  updatedById Int  @map("updated_by")
  updatedBy   User @relation("assignee_group_updated_by", fields: [updatedById], references: [id])

  deletedById Int?  @map("deleted_by")
  deletedBy   User? @relation("assignee_group_deleted_by", fields: [deletedById], references: [id])

  @@map("assignee_groups")
}
