# @import ../../../global.http

### Setup — Create Source dependency
POST {{baseUrl}}/source
...headers
Content-Type: multipart/form-data

name=Task Test Source
workspaceId={{workspaceId}}

{{@response
  exports.taskSrcId = response.parsedBody.id;
}}

?? status == 201

### Setup — Create Assignee dependency
POST {{baseUrl}}/assignee
...headers

{
  "name": "Task Test Assignee",
  "color": "#1E88E5",
  "workspaceId": {{workspaceId}},
  "users": []
}

{{@response
  exports.taskAssId = response.parsedBody.id;
}}

?? status == 201

### Create Task — valid payload
POST {{baseUrl}}/task
...headers

{
  "title": "HTTP Test Task",
  "deadlineType": "IMMEDIATE",
  "workspaceId": {{workspaceId}},
  "sourceId": {{taskSrcId}},
  "assignees": [{ "id": {{taskAssId}} }]
}

{{@response
  exports.taskId = response.parsedBody.id;
}}

?? status == 201

### Create Task — missing title (expect 400)
POST {{baseUrl}}/task
...headers

{
  "deadlineType": "IMMEDIATE",
  "workspaceId": {{workspaceId}}
}

?? status == 400

### Create Task — invalid deadlineType (expect 400)
POST {{baseUrl}}/task
...headers

{
  "title": "Bad Deadline Task",
  "deadlineType": "INVALID",
  "workspaceId": {{workspaceId}}
}

?? status == 400

### Get Tasks in workspace
GET {{baseUrl}}/task?workspaceId={{workspaceId}}
...headers

?? status == 200

### Get personal Tasks
GET {{baseUrl}}/task/personal
...headers

?? status == 200

### Get Task by id
GET {{baseUrl}}/task/{{taskId}}
...headers

?? status == 200

### Update Task
PATCH {{baseUrl}}/task/{{taskId}}
...headers

{
  "title": "HTTP Test Task Updated",
  "flagged": true,
  "notes": "Updated notes",
  "assignees": [{ "id": {{taskAssId}}, "description": "Lead" }]
}

?? status == 200

### Delete Task — non-existent id (expect 400)
DELETE {{baseUrl}}/task/99999
...headers

?? status == 400

### Cleanup — Delete Task
DELETE {{baseUrl}}/task/{{taskId}}
...headers

?? status == 200

### Cleanup — Delete Assignee
DELETE {{baseUrl}}/assignee/{{taskAssId}}
...headers

?? status == 200

### Cleanup — Delete Source
DELETE {{baseUrl}}/source/{{taskSrcId}}
...headers

?? status == 200
