# @import ../../../global.http

### Create Task — valid payload
POST {{baseUrl}}/task
...headers

{
  "title": "Secure the perimeter",
  "description": "Full perimeter check required",
  "flagged": false,
  "deadlineType": "hard",
  "dueDate": "2026-04-01T12:00:00.000Z",
  "notes": "Initial notes",
  "workspaceId": {{workspaceId}},
  "sourceId": {{sourceId}},
  "assignees": [{ "id": {{assigneeId}} }],
  "tags": ["priority"]
}

{{@response
  exports.taskId = response.parsedBody.id;
}}

?? status == 201

### Create Task — missing required fields (expect 400)
POST {{baseUrl}}/task
...headers

{
  "description": "Missing title and other fields"
}

?? status == 400

### Get all Tasks in workspace
GET {{baseUrl}}/task?workspaceId={{workspaceId}}
...headers

?? status == 200

### Get all Task rows in workspace
GET {{baseUrl}}/task/rows?workspaceId={{workspaceId}}
...headers

?? status == 200

### Get personal Tasks
GET {{baseUrl}}/task/personal
...headers

?? status == 200

### Get personal Task rows
GET {{baseUrl}}/task/personal/rows
...headers

?? status == 200

### Get Task by id
GET {{baseUrl}}/task/{{13}}
...headers

?? status == 200

### Update Task
PATCH {{baseUrl}}/task/{{13}}
...headers

{
  "title": "Secure the perimeter — updated",
  "flagged": true,
  "notes": "Updated notes",
  "assignees": [
    { "id": {{25}}, "description": "1" },
    { "id": {{23}}, "description": "2" }
    ],
  "tags": ["priority", "urgent"]
}

?? status == 200

### Delete Task — non-existent id (expect 400)
DELETE {{baseUrl}}/task/99999
...headers

?? status == 400

### Delete Task
DELETE {{baseUrl}}/task/{{taskId}}
...headers

?? status == 200