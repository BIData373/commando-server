model Task {
  id           Int              @id @default(autoincrement())
  title        String
  description  String?          @db.Text
  flagged      Boolean          @default(false)
  deadlineType DeadlineType     @map("deadline_type")
  dueDate      DateTime?        @map("due_date")
  notes        String?
  creationType TaskCreationType @default(HUMAN) @map("creation_type")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById Int  @map("created_by")
  createdBy   User @relation("task_created_by", fields: [createdById], references: [id])

  updatedById Int  @map("updated_by")
  updatedBy   User @relation("task_updated_by", fields: [updatedById], references: [id])

  deletedById Int? @map("deleted_by")
  deletedBy   User? @relation("task_deleted_by", fields: [deletedById], references: [id])

  workspaceId Int       @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  sourceId Int?    @map("source_id")
  source   Source? @relation(fields: [sourceId], references: [id])

  archivedWorkspaceAssigneeTask ArchivedWorkspaceAssigneeTask[]
  archivedUserAssigneeTask      ArchivedUserAssigneeTask[]
  tags                          Tag[]                           @relation("tasks_tags")
  assigneeStatuses              AssigneeTaskStatus[]
  messages                      Message[]
  history                       TaskHistory[]

  @@map("tasks")
}

enum DeadlineType {
  IMMEDIATE
  DATE
  ROLLING
}

enum TaskCreationType {
  HUMAN
  AI_HUMAN
  AI
}
