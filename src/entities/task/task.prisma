model Task {
  id           Int              @id @default(autoincrement())
  title        String
  description  String?          @db.Text
  flagged      Boolean          @default(false)
  deadlineType DeadlineType     @map("deadline_type")
  dueDate      DateTime?        @map("due_date")
  notes        String?
  creationType TaskCreationType @default(HUMAN) @map("creation_type")
  archivedAt   DateTime?        @map("archived_at")

  // Meta Fields
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy Int       @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy Int       @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  workspaceId Int       @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  sourceId Int?    @map("source_id")
  source   Source? @relation(fields: [sourceId], references: [id])

  statusId Int              @map("status_id")
  status   WorkspaceStatus  @relation(fields: [statusId], references: [id])

  archivedWorkspaceAssigneeTask ArchivedWorkspaceAssigneeTask[]
  archivedUserAssigneeTask ArchivedUserAssigneeTask[]
  tags             Tag[]                @relation("tasks_tags")
  assigneeStatuses AssigneeTaskStatus[]
  messages         Message[]
  history          TaskHistory[]

  @@map("tasks")
}

enum DeadlineType {
  IMMEDIATE
  DATE
  ROLLING
}

enum TaskCreationType {
  HUMAN
  AI_HUMAN
  AI
}
