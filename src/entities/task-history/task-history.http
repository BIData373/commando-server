# @import ../../../global.http

### Setup — Create Source
POST {{baseUrl}}/source
...headers
Content-Type: multipart/form-data

name=History Test Source
workspaceId={{workspaceId}}

{{@response
  exports.thSrcId = response.parsedBody.id;
}}

?? status == 201

### Setup — Create Assignee
POST {{baseUrl}}/assignee
...headers

{
  "name": "History Test Assignee",
  "color": "#FF7043",
  "workspaceId": {{workspaceId}},
  "users": []
}

{{@response
  exports.thAssId = response.parsedBody.id;
}}

?? status == 201

### Setup — Create Task
POST {{baseUrl}}/task
...headers

{
  "title": "History Test Task",
  "deadlineType": "IMMEDIATE",
  "workspaceId": {{workspaceId}},
  "sourceId": {{thSrcId}},
  "assignees": [{ "id": {{thAssId}} }]
}

{{@response
  exports.thTaskId = response.parsedBody.id;
}}

?? status == 201

### Get TaskHistory for task
GET {{baseUrl}}/task-history?taskId={{thTaskId}}
...headers

?? status == 200

### Cleanup — Delete Task
DELETE {{baseUrl}}/task/{{thTaskId}}
...headers

?? status == 200

### Cleanup — Delete Assignee
DELETE {{baseUrl}}/assignee/{{thAssId}}
...headers

?? status == 200

### Cleanup — Delete Source
DELETE {{baseUrl}}/source/{{thSrcId}}
...headers

?? status == 200
