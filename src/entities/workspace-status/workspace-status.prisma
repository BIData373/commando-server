model WorkspaceStatus {
  id    Int                 @id @default(autoincrement())
  name  String
  color String
  type  WorkspaceStatusType @map("status_type")

  workspaceId Int       @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  assigneeTaskStatuses AssigneeTaskStatus[]

  @@map("workspace_statuses")
}

enum WorkspaceStatusType {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}