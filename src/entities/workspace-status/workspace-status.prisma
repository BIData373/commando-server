model WorkspaceStatus {
  id    Int                 @id @default(autoincrement())
  name  String
  color String
  type  WorkspaceStatusType @default(NOT_STARTED) @map("status_type")

  workspaceId Int       @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  assigneeTaskStatuses AssigneeTaskStatus[]
  tasks                Task[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at") @updatedAt

  @@map("workspace_statuses")
}

enum WorkspaceStatusType {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}
