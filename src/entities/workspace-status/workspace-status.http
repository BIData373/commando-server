# @import ../../../global.http

### Create WorkspaceStatus — valid payload
POST {{baseUrl}}/workspace-status
...headers

{
  "name": "HTTP Test Status",
  "color": "#FF5733",
  "type": "IN_PROGRESS",
  "workspaceId": {{workspaceId}}
}

{{@response
  exports.workspaceStatusId = response.parsedBody.id;
}}

?? status == 201

### Create WorkspaceStatus — missing type (expect 400)
POST {{baseUrl}}/workspace-status
...headers

{
  "name": "Missing Type",
  "color": "#FF5733",
  "workspaceId": {{workspaceId}}
}

?? status == 400

### Create WorkspaceStatus — invalid type enum (expect 400)
POST {{baseUrl}}/workspace-status
...headers

{
  "name": "Bad Type",
  "color": "#FF5733",
  "type": "INVALID_TYPE",
  "workspaceId": {{workspaceId}}
}

?? status == 400

### Get WorkspaceStatuses in workspace
GET {{baseUrl}}/workspace-status?workspaceId={{workspaceId}}
...headers

?? status == 200

### Get WorkspaceStatus by id
GET {{baseUrl}}/workspace-status/{{workspaceStatusId}}
...headers

?? status == 200

### Update WorkspaceStatus
PATCH {{baseUrl}}/workspace-status/{{workspaceStatusId}}
...headers

{
  "name": "HTTP Test Status Updated",
  "type": "COMPLETED"
}

?? status == 200

### Delete WorkspaceStatus — non-existent id (expect 400)
DELETE {{baseUrl}}/workspace-status/99999
...headers

?? status == 400

### Cleanup — Delete WorkspaceStatus
DELETE {{baseUrl}}/workspace-status/{{workspaceStatusId}}
...headers

?? status == 200
