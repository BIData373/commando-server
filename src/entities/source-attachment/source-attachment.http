# @import ../../../global.http

### Setup — create parent source
POST {{baseUrl}}/source
...formHeaders
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="name"

Attachment Test Source
--{{boundary}}
Content-Disposition: form-data; name="workspaceId"

{{workspaceId}}
--{{boundary}}--

{{@response
  exports.sourceId = response.parsedBody.id;
}}

?? status == 201

### Create Source Attachment — valid payload
POST {{baseUrl}}/source-attachment
...formHeaders
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="sourceId"

{{sourceId}}
--{{boundary}}
Content-Disposition: form-data; name="attachment"; filename="{{sampleFileName}}"
Content-Type: application/pdf

< {{sampleFile}}
--{{boundary}}--

{{@response
  exports.sourceAttachmentId = response.parsedBody.id;
}}

?? status == 201

### Create Source Attachment — missing file (expect 400)
POST {{baseUrl}}/source-attachment
...formHeaders
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="sourceId"

{{sourceId}}
--{{boundary}}--

?? status == 400

### Create Source Attachment — non-existent source (expect 400)
POST {{baseUrl}}/source-attachment
...formHeaders
Content-Type: multipart/form-data; boundary={{boundary}}

--{{boundary}}
Content-Disposition: form-data; name="sourceId"

99999
--{{boundary}}
Content-Disposition: form-data; name="attachment"; filename="{{sampleFileName}}"
Content-Type: application/pdf

< {{sampleFile}}
--{{boundary}}--

?? status == 400

### Get Source Attachment by id
GET {{baseUrl}}/source-attachment/{{sourceAttachmentId}}
...headers

?? status == 200

### Get Source Attachment signed url
GET {{baseUrl}}/source-attachment/{{sourceAttachmentId}}/signed-url
...headers

?? status == 200

### Get Source Attachment signed url — non-existent id (expect 400)
GET {{baseUrl}}/source-attachment/99999/signed-url
...headers

?? status == 400

### Update Source Attachment — visible to assignees
PATCH {{baseUrl}}/source-attachment/{{sourceAttachmentId}}
...headers

{
  "visibleToAssignees": true
}

?? status == 200

### Delete Source Attachment — non-existent id (expect 400)
DELETE {{baseUrl}}/source-attachment/99999
...headers

?? status == 400

### Get Source — attachment listed on source
GET {{baseUrl}}/source/{{sourceId}}
...headers

?? status == 200
?? js response.parsedBody.attachments.some(a => a.id === sourceAttachmentId) == true

### Delete Source Attachment
DELETE {{baseUrl}}/source-attachment/{{sourceAttachmentId}}
...headers

?? status == 200

### Get Source Attachment — after delete (expect 400)
GET {{baseUrl}}/source-attachment/{{sourceAttachmentId}}
...headers

?? status == 400

### Teardown — delete parent source
DELETE {{baseUrl}}/source/{{sourceId}}
...headers

?? status == 200
