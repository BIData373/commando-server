model Pikud {
  id   Int     @id @default(autoincrement())
  name String
  icon String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById Int  @map("created_by")
  createdBy   User @relation("pikud_created_by", fields: [createdById], references: [id])

  updatedById Int  @map("updated_by")
  updatedBy   User @relation("pikud_updated_by", fields: [updatedById], references: [id])

  deletedById Int? @map("deleted_by")
  deletedBy   User? @relation("pikud_deleted_by", fields: [deletedById], references: [id])

  workspaces Workspace[]

  @@map("pikuds")
}
