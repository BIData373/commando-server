# @import ../../../global.http

### Create Assignee — containing the requesting user
POST {{baseUrl}}/assignee
...headers

{
  "name": "Personal Archive Target",
  "color": "#1E88E5",
  "workspaceId": {{workspaceId}},
  "users": [{ "upn": "yael" }]
}

{{@response
  exports.personalAssigneeId = response.parsedBody.id;
}}

?? status == 201

### Create Task — assigned to that assignee
POST {{baseUrl}}/task
...headers

{
  "title": "Personal archive",
  "flagged": false,
  "deadlineType": "IMMEDIATE",
  "workspaceId": {{workspaceId}},
  "assignees": [{ "id": {{personalAssigneeId}} }],
  "tags": []
}

{{@response
  exports.personalTaskId = response.parsedBody.id;
}}

?? status == 201

### Toggle User Task Archive — assignee the user does not belong to (expect 403)
PATCH {{baseUrl}}/archived-user-assignee-task?taskId={{personalTaskId}}&assigneeId={{personalAssigneeId}}
...headers
requestusername: s111111
is-bi: false

?? status == 403

### Toggle User Task Archive — missing assigneeId (expect 400)
PATCH {{baseUrl}}/archived-user-assignee-task?taskId={{personalTaskId}}
...headers
requestusername: yael
is-bi: false

?? status == 400

### Toggle User Task Archive — missing taskId (expect 400)
PATCH {{baseUrl}}/archived-user-assignee-task?assigneeId={{personalAssigneeId}}
...headers
requestusername: yael
is-bi: false

?? status == 400

### Toggle User Task Archive — archive
PATCH {{baseUrl}}/archived-user-assignee-task?taskId={{personalTaskId}}&assigneeId={{personalAssigneeId}}
...headers
requestusername: yael
is-bi: false

?? status == 204

### Toggle User Task Archive — unarchive
PATCH {{baseUrl}}/archived-user-assignee-task?taskId={{personalTaskId}}&assigneeId={{personalAssigneeId}}
...headers
requestusername: yael
is-bi: false

?? status == 204

### Delete Task
DELETE {{baseUrl}}/task/{{personalTaskId}}
...headers

?? status == 200

### Delete Assignee
DELETE {{baseUrl}}/assignee/{{personalAssigneeId}}
...headers

?? status == 200
