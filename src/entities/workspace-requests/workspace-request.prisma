model WorkspaceRequest {
    id Int @id @default(autoincrement())

    ///[WorkspaceRequestDetails]
    details Json
    status  WorkspaceRequestStatus @default(PENDING)

    declineMessage String? @map("decline_message")

    // Meta Fields
    createdAt DateTime  @default(now()) @map("created_at")
    createdBy Int       @map("created_by")
    updatedAt DateTime  @updatedAt @map("updated_at")
    updatedBy Int       @map("updated_by")
    deletedAt DateTime? @map("deleted_at")
    deletedBy Int?      @map("deleted_by")

    @@map("workspace_requests")
}

enum WorkspaceRequestStatus {
    PENDING
    APPROVED
    REJECTED

    @@map("workspace_request_status")
}
