model WorkspaceRequest {
    id Int @id @default(autoincrement())

    ///[WorkspaceRequestDetails]
    details Json
    status  WorkspaceRequestStatus @default(PENDING)

    declineMessage String? @map("decline_message")

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    createdById Int  @map("created_by")
    createdBy   User @relation("workspace_request_created_by", fields: [createdById], references: [id])

    updatedById Int  @map("updated_by")
    updatedBy   User @relation("workspace_request_updated_by", fields: [updatedById], references: [id])

    deletedById Int? @map("deleted_by")
    deletedBy   User? @relation("workspace_request_deleted_by", fields: [deletedById], references: [id])

    @@map("workspace_requests")
}

enum WorkspaceRequestStatus {
    PENDING
    APPROVED
    REJECTED

    @@map("workspace_request_status")
}
