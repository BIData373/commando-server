### Cleanup — delete the duplicate-title request
DELETE {{baseUrl}}/workspace-requests/{{duplicateTitleRequestId}}
...headers

?? status == 200

# ─────────────────────────────────────────────────────────────
# Approve flow — creates a real Workspace + MANAGER permissions
# ─────────────────────────────────────────────────────────────

### Approve flow — create the request to approve
POST {{baseUrl}}/workspace-requests
...headers

{
  "title": "{{approveTitle}}",
  "urlName": "{{approveUrlName}}",
  "pikudId": 1,
  "icon": "ops-icon",
  "managers": ["{{managerUpn}}"]
}

{{@response
  exports.approveRequestId = response.parsedBody.id;
}}

?? status == 201

### Approve the request — upserts the workspace, users and MANAGER permissions in one transaction
PATCH {{baseUrl}}/workspace-requests/1
...headers

{
  "status": "APPROVED"
}

?? status == 200

### Approved request — declineMessage is ignored while status is APPROVED
PATCH {{baseUrl}}/workspace-requests/{{approveRequestId}}
...headers

{
  "declineMessage": "לא אמור להישמר"
}

?? status == 200

### Re-approve the same request — not a new decision, no second workspace (expect 200)
PATCH {{baseUrl}}/workspace-requests/{{approveRequestId}}
...headers

{
  "status": "APPROVED"
}

?? status == 200

### Create Workspace Request — title now belongs to a real workspace (expect 400)
POST {{baseUrl}}/workspace-requests
...headers

{
  "title": "{{approveTitle}}",
  "urlName": "title-taken-by-workspace",
  "pikudId": 1,
  "managers": ["{{managerUpn}}"]
}

?? status == 400

### Create Workspace Request — urlName now belongs to a real workspace (expect 400)
POST {{baseUrl}}/workspace-requests
...headers

{
  "title": "שם כתובת תפוס {{approveUrlName}}",
  "urlName": "{{approveUrlName}}",
  "pikudId": 1,
  "managers": ["{{managerUpn}}"]
}

?? status == 400

### Approve flow cleanup — find the workspace the approval created
GET {{baseUrl}}/workspace?urlName={{approveUrlName}}
...headers

{{@response
  exports.approvedWorkspaceId = response.parsedBody[0].id;
}}

?? status == 200

### Approve flow cleanup — delete the created workspace
# Requires MANAGER on that workspace or a BI user. The approval granted MANAGER to
# `managerUpn`, so this passes when the caller is that user or has `is-bi`.
DELETE {{baseUrl}}/workspace/{{approvedWorkspaceId}}
...headers

?? status == 200

### Approve flow cleanup — delete the approved request
DELETE {{baseUrl}}/workspace-requests/{{approveRequestId}}
...headers

?? status == 200