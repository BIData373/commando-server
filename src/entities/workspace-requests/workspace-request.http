# @import ../../../global.http

{{
  // The approve flow creates a REAL workspace, and workspace title/urlName are
  // unique per the `failIfExists` validators. Suffixing with a run id keeps this
  // file re-runnable — approval cannot be undone through the API.
  const runId = Date.now();

  exports.approveTitle = `סביבה לאישור ${runId}`;
  exports.approveUrlName = `approve-flow-${runId}`;
  exports.patchTitle = `סביבה מעודכנת ${runId}`;
  exports.patchUrlName = `patched-url-${runId}`;
  exports.managerUpn = 's9336069';
}}

### Create Workspace Request — valid payload
POST {{baseUrl}}/workspace-requests
...headers

{
  "title": "בקשה חדשה",
  "urlName": "new-request",
  "pikudId": 1,
  "managers": ["s9336069"]
}

{{@response
  exports.workspaceRequestId = response.parsedBody.id;
}}

?? status == 201

### Create Workspace Request — duplicate request title is allowed (expect 201)
# `title`/`urlName` are validated with EntityExists('workspace', { failIfExists }),
# which queries the WORKSPACE table — not workspace_requests. Two PENDING requests
# may therefore share a title. The real collision is covered in the approve flow below.
POST {{baseUrl}}/workspace-requests
...headers

{
  "title": "בקשה חדשה",
  "urlName": "another-url-name",
  "pikudId": 1,
  "managers": ["s9336069"]
}

{{@response
  exports.duplicateTitleRequestId = response.parsedBody.id;
}}

?? status == 201

### Create Workspace Request — missing managers (expect 400)
POST {{baseUrl}}/workspace-requests
...headers

{
  "title": "בקשה ללא מנהלים",
  "urlName": "no-managers",
  "pikudId": 1
}

?? status == 400

### Create Workspace Request — managers is not an array (expect 400)
POST {{baseUrl}}/workspace-requests
...headers

{
  "title": "מנהלים לא מערך",
  "urlName": "managers-not-array",
  "pikudId": 1,
  "managers": "s9336069"
}

?? status == 400

### Create Workspace Request — duplicate managers (expect 400 from @ArrayUnique)
POST {{baseUrl}}/workspace-requests
...headers

{
  "title": "מנהלים כפולים",
  "urlName": "duplicate-managers",
  "pikudId": 1,
  "managers": ["s9336069", "s9336069"]
}

?? status == 400

