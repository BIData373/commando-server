# @import ../../../global.http

### Setup — Create WorkspaceStatus
POST {{baseUrl}}/workspace-status
...headers

{
  "name": "ATS Test Status",
  "color": "#42A5F5",
  "type": "NOT_STARTED",
  "workspaceId": {{workspaceId}}
}

{{@response
  exports.atsStsId = response.parsedBody.id;
}}

?? status == 201

### Setup — Create Source
POST {{baseUrl}}/source
...headers
Content-Type: multipart/form-data

name=ATS Test Source
workspaceId={{workspaceId}}

{{@response
  exports.atsSrcId = response.parsedBody.id;
}}

?? status == 201

### Setup — Create Assignee
POST {{baseUrl}}/assignee
...headers

{
  "name": "ATS Test Assignee",
  "color": "#66BB6A",
  "workspaceId": {{workspaceId}},
  "users": []
}

{{@response
  exports.atsAssId = response.parsedBody.id;
}}

?? status == 201

### Setup — Create Task
POST {{baseUrl}}/task
...headers

{
  "title": "ATS Test Task",
  "deadlineType": "IMMEDIATE",
  "workspaceId": {{workspaceId}},
  "sourceId": {{atsSrcId}},
  "assignees": [{ "id": {{atsAssId}} }]
}

{{@response
  exports.atsTaskId = response.parsedBody.id;
}}

?? status == 201

### Upsert AssigneeTaskStatus
PUT {{baseUrl}}/assignee-task-status
...headers

{
  "taskId": {{atsTaskId}},
  "assigneeId": {{atsAssId}},
  "statusId": {{atsStsId}},
  "description": "In review"
}

?? status == 200

### Get AssigneeTaskStatuses for task
GET {{baseUrl}}/assignee-task-status/{{atsTaskId}}
...headers

?? status == 200

### Update AssigneeTaskStatus via upsert
PUT {{baseUrl}}/assignee-task-status
...headers

{
  "taskId": {{atsTaskId}},
  "assigneeId": {{atsAssId}},
  "statusId": {{atsStsId}},
  "description": "Updated review"
}

?? status == 200

### Delete non-existent AssigneeTaskStatus (expect error)
DELETE {{baseUrl}}/assignee-task-status?taskId=99999&assigneeId=99999
...headers

?? status >= 400

### Cleanup — Delete AssigneeTaskStatus
DELETE {{baseUrl}}/assignee-task-status?taskId={{atsTaskId}}&assigneeId={{atsAssId}}
...headers

?? status == 200

### Cleanup — Delete Task
DELETE {{baseUrl}}/task/{{atsTaskId}}
...headers

?? status == 200

### Cleanup — Delete Assignee
DELETE {{baseUrl}}/assignee/{{atsAssId}}
...headers

?? status == 200

### Cleanup — Delete Source
DELETE {{baseUrl}}/source/{{atsSrcId}}
...headers

?? status == 200

### Cleanup — Delete WorkspaceStatus
DELETE {{baseUrl}}/workspace-status/{{atsStsId}}
...headers

?? status == 200
