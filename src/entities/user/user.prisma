model User {
  id  Int    @id @default(autoincrement())
  upn String @unique
  personalAreaEnteredAt DateTime? @map("personal_area_entered_at")

  /// [UserInfo]
  info Json?

  userWorkspaceVisits UserWorkspaceVisits[]
  userViewedTasks UserViewedTasks[]
  archivedUserAssigneeTask ArchivedUserAssigneeTask[]
  assignees   Assignee[]    @relation("assignee_users")
  permissions Permission[]
  history     TaskHistory[]
  messages    Message[]
  userViews   UserView[]

  @@map("users")
}
