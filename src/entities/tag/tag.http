# @import ../../../global.http

### Create Tag — valid payload
POST {{baseUrl}}/tag
...headers

{
  "name": "http-test-tag",
  "workspaceId": {{workspaceId}}
}

{{@response
  exports.tagId = response.parsedBody.id;
}}

?? status == 201

### Create Tag — duplicate name in workspace (expect 400)
POST {{baseUrl}}/tag
...headers

{
  "name": "http-test-tag",
  "workspaceId": {{workspaceId}}
}

?? status == 400

### Create Tag — missing name (expect 400)
POST {{baseUrl}}/tag
...headers

{
  "workspaceId": {{workspaceId}}
}

?? status == 400

### Get Tags in workspace
GET {{baseUrl}}/tag?workspaceId={{workspaceId}}
...headers

?? status == 200

### Get Tag by id
GET {{baseUrl}}/tag/{{tagId}}
...headers

?? status == 200

### Update Tag name
PATCH {{baseUrl}}/tag/{{tagId}}
...headers

{
  "name": "http-test-tag-updated"
}

?? status == 200

### Delete Tag — non-existent id (expect 400)
DELETE {{baseUrl}}/tag/99999
...headers

?? status == 400

### Cleanup — Delete Tag
DELETE {{baseUrl}}/tag/{{tagId}}
...headers

?? status == 200
