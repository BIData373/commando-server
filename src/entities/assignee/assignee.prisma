model Assignee {
  id       Int     @id @default(autoincrement())
  name     String
  color    String
  icon     String?
  iconName String? @map("icon_name")

  workspaceId Int       @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById Int  @map("created_by")
  createdBy   User @relation("assignee_created_by", fields: [createdById], references: [id])

  updatedById Int  @map("updated_by")
  updatedBy   User @relation("assignee_updated_by", fields: [updatedById], references: [id])

  deletedById Int? @map("deleted_by")
  deletedBy   User? @relation("assignee_deleted_by", fields: [deletedById], references: [id])

  archivedWorkspaceAssigneeTask ArchivedWorkspaceAssigneeTask[]
  archivedUserAssigneeTask ArchivedUserAssigneeTask[]
  users        User[]               @relation("assignee_users")
  taskStatuses AssigneeTaskStatus[]

  @@map("assignees")
}
