# @import ../../../global.http

### Create Assignee — valid payload
POST {{baseUrl}}/assignee
...headers

{
  "name": "HTTP Test Assignee",
  "color": "#E53935",
  "icon": "shield",
  "workspaceId": {{workspaceId}},
  "users": []
}

{{@response
  exports.assigneeId = response.parsedBody.id;
}}

?? status == 201

### Create Assignee — missing name (expect 400)
POST {{baseUrl}}/assignee
...headers

{
  "color": "#E53935",
  "workspaceId": {{workspaceId}},
  "users": []
}

?? status == 400

### Get Assignees in workspace
GET {{baseUrl}}/assignee?workspaceId={{workspaceId}}
...headers

?? status == 200

### Get Assignee by id
GET {{baseUrl}}/assignee/{{assigneeId}}
...headers

?? status == 200

### Update Assignee
PATCH {{baseUrl}}/assignee/{{assigneeId}}
...headers

{
  "name": "HTTP Test Assignee Updated",
  "icon": "shield-check"
}

?? status == 200

### Delete Assignee — non-existent id (expect 400)
DELETE {{baseUrl}}/assignee/99999
...headers

?? status == 400

### Cleanup — Delete Assignee
DELETE {{baseUrl}}/assignee/{{assigneeId}}
...headers

?? status == 200
