model UserViewedTasks {
    userId Int  @map("user_id")
    taskId Int  @map("task_id")
    panelViewedAt DateTime? @map("panel_viewed_at")

    user User @relation(fields: [userId], references: [id])
    task Task @relation(fields: [taskId], references: [id])

    @@id([userId, taskId])
    @@map("user_viewed_tasks")
    // @@index([userId, taskId]) 
    // do we need also on task make the Index?
}