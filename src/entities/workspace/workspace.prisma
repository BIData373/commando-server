model Workspace {
  id                     Int     @id @default(autoincrement())
  title                  String  @unique
  urlName                String  @unique @map("url_name")
  icon                   String?
  assigneeStatusEditable Boolean @default(false) @map("assignee_status_editable")
  chatNotification       Boolean @default(false) @map("chat_notification")
  mailNotification       Boolean @default(false) @map("mail_notification")

  // Meta Fields
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy Int       @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy Int       @map("updated_by")
  deletedAt DateTime? @map("deleted_at")
  deletedBy Int?      @map("deleted_by")

  pikudId Int   @map("pikud_id")
  pikud   Pikud @relation(fields: [pikudId], references: [id])

  userWorkspaceEntries UserWorkspaceEntries[]
  tags              Tag[]
  tasks             Task[]
  workspaceStatuses WorkspaceStatus[]
  permissions       Permission[]
  tasksHistory      TaskHistory[]
  sources           Source[]
  assignees         Assignee[]
  userViews         UserView[]

  @@map("workspaces")
}
