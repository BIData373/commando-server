model Workspace {
  id                     Int     @id @default(autoincrement())
  title                  String  @unique
  urlName                String  @unique @map("url_name")
  icon                   String?
  assigneeStatusEditable Boolean @default(false) @map("assignee_status_editable")
  chatNotification       Boolean @default(false) @map("chat_notification")
  mailNotification       Boolean @default(false) @map("mail_notification")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById Int  @map("created_by")
  createdBy   User @relation("workspace_created_by", fields: [createdById], references: [id])

  updatedById Int  @map("updated_by")
  updatedBy   User @relation("workspace_updated_by", fields: [updatedById], references: [id])

  deletedById Int? @map("deleted_by")
  deletedBy   User? @relation("workspace_deleted_by", fields: [deletedById], references: [id])

  pikudId Int   @map("pikud_id")
  pikud   Pikud @relation(fields: [pikudId], references: [id])

  tags              Tag[]
  tasks             Task[]
  workspaceStatuses WorkspaceStatus[]
  permissions       Permission[]
  tasksHistory      TaskHistory[]
  sources           Source[]
  assignees         Assignee[]
  userViews         UserView[]

  @@map("workspaces")
}
