# @import ../../../global.http

### Setup — Create Source
POST {{baseUrl}}/source
...headers
Content-Type: multipart/form-data

name=Message Test Source
workspaceId={{workspaceId}}

{{@response
  exports.msgSrcId = response.parsedBody.id;
}}

?? status == 201

### Setup — Create Assignee
POST {{baseUrl}}/assignee
...headers

{
  "name": "Message Test Assignee",
  "color": "#AB47BC",
  "workspaceId": {{workspaceId}},
  "users": []
}

{{@response
  exports.msgAssId = response.parsedBody.id;
}}

?? status == 201

### Setup — Create Task
POST {{baseUrl}}/task
...headers

{
  "title": "Message Test Task",
  "deadlineType": "IMMEDIATE",
  "workspaceId": {{workspaceId}},
  "sourceId": {{msgSrcId}},
  "assignees": [{ "id": {{msgAssId}} }]
}

{{@response
  exports.msgTaskId = response.parsedBody.id;
}}

?? status == 201

### Create Message — valid payload
POST {{baseUrl}}/message
...headers

{
  "taskId": {{msgTaskId}},
  "content": "HTTP test message content."
}

{{@response
  exports.messageId = response.parsedBody.id;
}}

?? status == 201

### Create Message — missing content (expect 400)
POST {{baseUrl}}/message
...headers

{
  "taskId": {{msgTaskId}}
}

?? status == 400

### Get Messages in task
GET {{baseUrl}}/message?taskId={{msgTaskId}}
...headers

?? status == 200

### Get Message by id
GET {{baseUrl}}/message/{{messageId}}
...headers

?? status == 200

### Update Message
PATCH {{baseUrl}}/message/{{messageId}}
...headers

{
  "content": "HTTP test message updated."
}

?? status == 200

### Delete Message — non-existent id (expect 400)
DELETE {{baseUrl}}/message/99999
...headers

?? status == 400

### Cleanup — Delete Message
DELETE {{baseUrl}}/message/{{messageId}}
...headers

?? status == 200

### Cleanup — Delete Task
DELETE {{baseUrl}}/task/{{msgTaskId}}
...headers

?? status == 200

### Cleanup — Delete Assignee
DELETE {{baseUrl}}/assignee/{{msgAssId}}
...headers

?? status == 200

### Cleanup — Delete Source
DELETE {{baseUrl}}/source/{{msgSrcId}}
...headers

?? status == 200
