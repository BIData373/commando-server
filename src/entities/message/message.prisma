model Message {
  id      Int    @id @default(autoincrement())
  content String @db.Text

  userId Int @map("user_id")
  taskId Int @map("task_id")

  user User @relation("message_user", fields: [userId], references: [id])
  task Task @relation(fields: [taskId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  createdById Int  @map("created_by")
  createdBy   User @relation("message_created_by", fields: [createdById], references: [id])

  updatedById Int  @map("updated_by")
  updatedBy   User @relation("message_updated_by", fields: [updatedById], references: [id])

  deletedById Int? @map("deleted_by")
  deletedBy   User? @relation("message_deleted_by", fields: [deletedById], references: [id])

  @@map("messages")
}
