model UserViewedMessages {
    userId Int  @map("user_id")
    taskId Int  @map("task_id")
    viewedMessageAt DateTime? @map("viewed_message_at")
    viewedTaskAt DateTime @map("viewed_task_at") @default(now())

    user User @relation(fields: [userId], references: [id])
    task Task @relation(fields: [taskId], references: [id])

    @@id([userId, taskId])
    @@map("user_viewed_messages")
    @@index([userId])
}